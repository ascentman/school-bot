# Токен від @BotFather (обовʼязково)
BOT_TOKEN=123456:ABC-DEF...

# Назва школи — йде в заголовки звітів
SCHOOL_NAME=Ліцей №1 м. Львова

# Усі класи школи через кому. Створюються при старті, і саме з них вчитель
# обирає свої під час реєстрації. Прибрати клас звідси недостатньо — історія
# лишається; сховати з опитування можна командою /off_class.
SCHOOL_CLASSES=1-А,1-Б,2-А,2-Б,3-А,3-Б,4-А,4-Б,5-А,5-Б,6-А,7-А,8-А,9-А,10-А,11-А

# Telegram ID, які отримають права адміна при першому /start.
# Свій ID можна дізнатися у бота @userinfobot. Кілька — через кому.
BOOTSTRAP_ADMINS=123456789

# Часи джобів (Europe/Kyiv)
PROMPT_TIME=09:05
REMIND_TIMES=09:15,09:30          # кілька нагадувань через кому
DIGEST_TIME=09:45

# Стійкість до простою (блекаут, перезапуск). Якщо сервер піднявся після
# запланованого часу, бот догоняє пропущену розсилку — але не пізніше дедлайну.
CATCH_UP_DEADLINE=15:00
MISFIRE_GRACE_SECONDS=7200

# Google Sheets — необовʼязково. Без них бот працює, синк просто вимкнений.
# GOOGLE_CREDENTIALS_FILE=./secrets/service-account.json
# GOOGLE_SHEET_ID=1AbC...
